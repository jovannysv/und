# Copy this file to .env.local and fill in values from:
# Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup and configuration
#
# .env.local is gitignored (matches the *.local rule) - never commit real keys here.
# Each teammate creates their own .env.local locally, pointing at the same shared project.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
